[Unit]
Description=Serveur eversolo-screen (now playing Eversolo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
# Une version par dossier (versions.py) ; réglages et caches restent dans le
# dépôt de référence. Le garde revient à la version précédente si la nouvelle
# ne démarre pas trois fois de suite ; il n'empêche jamais le démarrage.
WorkingDirectory=/home/%i/eversolo-versions/courante
Environment=EVERSOLO_SCREEN_DATA=/home/%i/eversolo-screen
ExecStartPre=-/usr/bin/python3 /home/%i/.config/eversolo-screen/garde.py garde
ExecStart=/home/%i/eversolo-versions/courante/venv/bin/python server.py
Restart=on-failure
RestartSec=5

# Durcissement systemd
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
