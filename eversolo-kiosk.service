[Unit]
Description=Kiosque plein ecran eversolo-screen
After=systemd-user-sessions.service eversolo-screen@%i.service network-online.target
Wants=eversolo-screen@%i.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=%i
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=/bin/sh -c 'until curl -s -o /dev/null http://localhost:8080; do sleep 1; done'
ExecStart=/bin/sh -c 'exec /usr/bin/cage -- "$(command -v chromium-browser || command -v chromium)" --kiosk --noerrdialogs --disable-infobars --no-first-run --disable-features=Translate --ozone-platform=wayland --app=http://localhost:8080'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
