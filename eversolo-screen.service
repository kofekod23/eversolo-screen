[Unit]
Description=Serveur eversolo-screen (now playing DMP-A6)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/eversolo-screen
ExecStart=/home/%i/eversolo-screen/venv/bin/python server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
